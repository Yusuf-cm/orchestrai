generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  cases     Case[]
}

model Case {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  title        String
  domain       String
  adapterId    String
  institution  String   // JSON
  service      String?  // JSON
  intent       String   // JSON
  workflow     String   // JSON
  state        String   // JSON
  requirements String   @default("[]") // JSON
  artifacts    String   @default("[]") // JSON
  appointments String   @default("[]") // JSON
  tasks        String   @default("[]") // JSON
  evidence     String   @default("[]") // JSON
  status       String   @default("open")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditEvents AuditEvent[]
}

model AuditEvent {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor     String
  action    String
  stepId    String?
  input     String?  // JSON
  output    String?  // JSON
  success   Boolean  @default(true)
  timestamp DateTime @default(now())
}

model VoiceCache {
  id        String   @id @default(cuid())
  textHash  String   @unique
  audioPath String
  createdAt DateTime @default(now())
}
