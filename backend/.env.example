# Local development. Copy to backend/.env
DATABASE_URL="file:./dev.db"
PORT=4000
NODE_ENV=development

# Comma-separated. Must match the frontend origin exactly.
CORS_ORIGIN=http://localhost:43123,http://127.0.0.1:43123

# Optional. Without it, keyword classification handles intent and the app
# behaves identically.
OPENAI_API_KEY=

# Optional. Point at an OpenAI-compatible endpoint instead of OpenAI itself
# (e.g. NVIDIA NIM: https://integrate.api.nvidia.com/v1). Leave unset to use
# OpenAI directly.
OPENAI_BASE_URL=

# Optional. Defaults to gpt-4o-mini. Set to whatever model your OPENAI_BASE_URL
# serves, e.g. meta/llama-3.1-8b-instruct on NVIDIA.
OPENAI_MODEL=

# Optional. Without it, voice input is hidden and playback falls back to the
# browser's own speech synthesis.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ID_SW=

UPLOAD_DIR=./uploads/documents
VOICE_CACHE_DIR=./uploads/voice
