# Local development. Copy to backend/.env
DATABASE_URL="file:./dev.db"
PORT=4000
NODE_ENV=development

# Comma-separated. Must match the frontend origin exactly.
CORS_ORIGIN=http://localhost:43123,http://127.0.0.1:43123

# Optional. Without it, keyword classification handles intent and the app
# behaves identically.
OPENAI_API_KEY=

# Optional. Without it, voice input is hidden and playback falls back to the
# browser's own speech synthesis.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ID_SW=

UPLOAD_DIR=./uploads/documents
VOICE_CACHE_DIR=./uploads/voice
